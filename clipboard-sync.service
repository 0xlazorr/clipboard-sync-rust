[Unit]
Description=Secure Clipboard Sync Daemon (Rust version)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/repos/clipboard-sync-rust/target/release/clipboard-sync
WorkingDirectory=%h/repos/clipboard-sync-rust
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=default.target
